# Copy to .env and fill in. Every setting can also be passed as an environment variable.

# --- service ---
ENVIRONMENT=development            # development | test | production
SECRET_KEY=change-me-to-a-long-random-string   # signs tokens and media URLs — REQUIRED in production
DATABASE_URL=sqlite:///./data/comlogue.db      # or postgresql+psycopg://user:pass@host:5432/comlogue
MEDIA_DIR=./data/media
LOG_LEVEL=INFO
CORS_ORIGINS=                      # comma-separated, only needed for browser clients

# --- AI ---
# auto = OpenAI when OPENAI_API_KEY is set, otherwise the offline demo provider (clearly flagged demo_mode).
AI_PROVIDER=auto                   # auto | openai | mock
OPENAI_API_KEY=
# OPENAI_BASE_URL=                 # optional (proxy / data residency)
# OPENAI_ORGANIZATION=
# OPENAI_PROJECT=
OPENAI_TIMEOUT_SECONDS=120
OPENAI_MAX_RETRIES=2
# Models are tried in order; the first one your account can use is remembered (comma-separated).
ASSESSMENT_MODELS=gpt-6.1-sol,gpt-6-sol,gpt-5.5
ASSESSMENT_REASONING_EFFORT=medium
CONVERSATION_MODELS=gpt-6-luna,gpt-5.4-mini,gpt-5-mini
CONVERSATION_REASONING_EFFORT=low
TRANSCRIPTION_MODELS=gpt-4o-transcribe,gpt-4o-mini-transcribe
DIARIZATION_MODELS=gpt-4o-transcribe-diarize
TTS_MODELS=gpt-4o-mini-tts
TTS_ENABLED=true
TURN_BACKGROUND_CHECK=true         # diarize each roleplay turn to catch background voices

# --- background jobs ---
JOBS_INLINE=false                  # true runs analysis synchronously (tests)
JOB_WORKERS=4

# --- auth & media ---
TOKEN_TTL_DAYS=365
MEDIA_URL_TTL_SECONDS=21600

# --- billing ---
# ALLOW_DEV_ENTITLEMENTS=true      # unset = allowed outside production (enables /v1/billing/dev-grant and /v1/dev/seed-demo)
APP_STORE_BUNDLE_ID=com.comlogue.app
APP_STORE_PRODUCT_IDS=comlogue.pro.monthly,comlogue.pro.yearly
APP_STORE_REQUIRE_VERIFICATION=false   # TODO(launch): implement Apple JWS verification, then set true

# --- limits & pricing (pricing is a pilot hypothesis, always shown before purchase) ---
MAX_UPLOAD_MB=100
MAX_RECORDING_MINUTES=60
MAX_TURN_SECONDS=600
FREE_SPAR_PER_WEEK=1
FREE_TALKS=1
RATE_LIMIT_AI_PER_HOUR=150
RATE_LIMIT_UPLOADS_PER_HOUR=30
PRICE_MONTHLY_USD=14.99
PRICE_YEARLY_USD=95.99
PRICE_MONTHLY_INR=399              # India (Meta.pricing for the "in" market); StoreKit's localized price wins in the app
PRICE_YEARLY_INR=2499
TRIAL_DAYS=7

# --- support & grievance contacts (shown in Meta.support; India's DPDP Act expects a grievance contact) ---
SUPPORT_EMAIL=support@comlogue.app
GRIEVANCE_EMAIL=grievance@comlogue.app
# GRIEVANCE_OFFICER=               # name of the grievance officer, once appointed

# --- notifications & push ---
# The scheduler produces event-prep, check-in, nudge and weekly-reveal notifications and delivers pending pushes.
# Unset = on everywhere except ENVIRONMENT=test.
# NOTIFICATIONS_SCHEDULER_ENABLED=true
NOTIFICATIONS_TICK_SECONDS=300
# APNs token auth (Apple Developer → Keys → a key with "Apple Push Notifications service"). Without these the
# server keeps notifications in the in-app inbox only and devices report push_enabled=false.
# Never commit the key: pass it as a secret.
# APNS_KEY_ID=ABC123DEFG
# APNS_TEAM_ID=TEAM123456
# APNS_PRIVATE_KEY_PATH=/run/secrets/AuthKey_ABC123DEFG.p8   # or APNS_PRIVATE_KEY with the PEM contents (\n allowed)
APNS_BUNDLE_ID=com.comlogue.app
